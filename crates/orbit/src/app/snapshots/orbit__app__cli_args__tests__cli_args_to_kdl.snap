---
source: crates/orbit/src/app/cli_args.rs
expression: output
---
name orbit
bin orbit
version "x.y.z"
about "Extends `docker compose up` and `run` to deploy local config files and sops-encrypted secrets to a remote host"
unknown_flags error
subcommand_required #true
flag --log-level help="Set the log level." global=#true env=ORBIT_LOG_LEVEL {
    arg <LOG_LEVEL> {
        choices ignore_case=#true {
            choice error help="Errors only."
            choice warn help="Errors and warnings."
            choice info help="Errors, warnings, and info."
            choice debug help="Errors, warnings, info, and debug."
            choice trace help="Errors, warnings, info, debug, and trace."
        }
    }
}
flag --host help="Docker host to deploy to." {
    long_help #"""
Docker host to deploy to.

Default: `x-orbit.host` in `docker-compose.yml`
"""#
    arg <HOST>
}
flag "-h --help" help="Print help" action=help builtin=#true
flag "-V --version" help="Print version" action=version builtin=#true
cmd up help="Create and start containers on the Docker host." {
    flag "-d --detach" help="Run containers in the background."
    flag --force-recreate help="Recreate containers even if their configuration is unchanged."
    flag --pull help="Pull images before starting." {
        arg <PULL> {
            choices {
                choice always help="Always pull."
                choice missing help="Pull only missing images."
                choice never help="Never pull."
            }
        }
    }
    flag --build help="Build images before starting."
    flag --no-build help="Don't build images, even if the service's pull policy says to."
    flag --no-deps help="Don't start dependencies of the given services."
    flag --remove-orphans help="Remove containers for services not in the Compose file."
    flag --wait help="Wait for services to be running or healthy, then detach."
    flag --wait-timeout help="Maximum seconds to wait for services to be running or healthy." {
        arg <SECONDS>
    }
    flag "-t --timeout" help="Seconds to wait for containers to stop before killing them." {
        arg <SECONDS>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[SERVICES]..." help="Services to start." {
        long_help #"""
Services to start.

Default: every service
"""#
    }
}
cmd run help="Run a one-off command in a new container on the Docker host." {
    flag --rm help="Remove the container when it exits."
    flag --pull help="Pull images before starting." {
        arg <PULL> {
            choices {
                choice always help="Always pull."
                choice missing help="Pull only missing images."
                choice never help="Never pull."
            }
        }
    }
    flag "-e --env" help="Set an environment variable in the container." var=#true {
        arg "<KEY=VALUE>"
    }
    flag --build help="Build the image before starting."
    flag --no-deps help="Don't start the service's dependencies."
    flag "-d --detach" help="Run the container in the background and print its ID."
    flag "-T --no-tty" help="Don't allocate a pseudo-TTY."
    flag --entrypoint help="Override the entrypoint of the image." {
        arg <ENTRYPOINT>
    }
    flag "-u --user" help="Run as this user name or UID." {
        arg <USER>
    }
    flag "-w --workdir" help="Working directory inside the container." {
        arg <PATH>
    }
    flag --name help="Name the container." {
        arg <NAME>
    }
    flag "-P --service-ports" help="Publish the service's ports to the host."
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <SERVICE> help="Service to run." double_dash=automatic
    arg "[ARGS]..." help="Arguments passed to the container verbatim."
}
