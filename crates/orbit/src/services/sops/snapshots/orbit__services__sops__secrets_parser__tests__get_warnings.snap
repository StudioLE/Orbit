---
source: crates/orbit/src/services/sops/secrets_parser.rs
expression: warnings
---
" abc":
  - "Secret `A` starts or ends with whitespace outside quotes, which Compose would trim. Wrap it in single quotes"
"\"":
  - "Secret `A` starts with a quote but doesn't end with the same one, so Orbit keeps it as written"
"\"$x\"":
  - "Secret `A` has `$` in double quotes, which Compose would expand. Use single quotes"
"\"a\\nb\"": []
"\"a\\tb\"":
  - "Secret `A` has `\\` in double quotes, which Compose would unescape. Use single quotes"
"\"abc\" # note":
  - "Secret `A` starts with a quote but doesn't end with the same one, so Orbit keeps it as written"
"\"abc'":
  - "Secret `A` starts with a quote but doesn't end with the same one, so Orbit keeps it as written"
$2a$x:
  - "Secret `A` has `$` outside quotes, which Compose would expand. Wrap it in single quotes"
"$x #y":
  - "Secret `A` has `$` outside quotes, which Compose would expand. Wrap it in single quotes"
  - "Secret `A` has ` #` outside quotes, which Compose would cut as a comment. Wrap it in single quotes"
"'$2a$x'": []
"'a #b'": []
"a #b":
  - "Secret `A` has ` #` outside quotes, which Compose would cut as a comment. Wrap it in single quotes"
abc: []
"abc ":
  - "Secret `A` starts or ends with whitespace outside quotes, which Compose would trim. Wrap it in single quotes"
